# ==========================================
# Configuración de Supabase (Vite)
# ==========================================
# Obtén estas credenciales en:
# https://supabase.com/dashboard/project/<tu-proyecto>/settings/api

# URL del proyecto Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon / public key)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Bucket para imágenes técnicas y diagramas (por defecto: repuestos)
VITE_SUPABASE_STORAGE_BUCKET=repuestos

# ==========================================
# Configuración adicional de la API (opcional)
# ==========================================
# URL base de endpoints REST si se utiliza backend auxiliar
VITE_API_URL=/api
